# Aurora PostgreSQL cluster, PROVISIONED (not Serverless v2). The Azure analogue is
# modules/azure/postgres-flexible. BYOC data-tier policy is provisioned (e.g.
# db.r7g.large + a reserved instance), never serverless/burstable, for a real
# install — matching the repo's Aurora-vs-serverless decision.
#
# Private: the cluster has no public access; it is reachable only from security
# groups in allowed_sg_ids (the EKS node SG) on 5432. The master password is
# generated by the composition and seeded into Secrets Manager there (the Azure
# postgres module takes the password the same way), so this module stays aws-only.
#
# Naming and tags come from the null-label base (module.this); see label.tf.

resource "aws_security_group" "cluster" {
  name        = "${module.this.id}-sg"
  description = "Aurora PostgreSQL ${module.this.id}"
  vpc_id      = var.vpc_id

  tags = merge(module.this.tags, { Name = "${module.this.id}-sg" })
}

resource "aws_security_group_rule" "ingress" {
  for_each                 = toset(var.allowed_sg_ids)
  type                     = "ingress"
  from_port                = 5432
  to_port                  = 5432
  protocol                 = "tcp"
  source_security_group_id = each.value
  security_group_id        = aws_security_group.cluster.id
  description              = "PostgreSQL from allowed security group"
}

resource "aws_security_group_rule" "egress" {
  type              = "egress"
  from_port         = 0
  to_port           = 0
  protocol          = "-1"
  cidr_blocks       = [var.vpc_cidr_block]
  security_group_id = aws_security_group.cluster.id
  description       = "Allow outbound within VPC"
}

resource "aws_db_subnet_group" "this" {
  name       = "${module.this.id}-subnet-group"
  subnet_ids = var.subnet_ids
  tags       = merge(module.this.tags, { Name = "${module.this.id}-subnet-group" })
}

# Storage is already encrypted at rest (storage_encrypted = true, below) using the
# AWS-managed RDS key. This finding asks for a customer-managed key (kms_key_id),
# which is left to the deployment to supply when CMK control is required.
#trivy:ignore:AVD-AWS-0079 Storage is encrypted (storage_encrypted=true); CMK (kms_key_id) is operator-optional.
resource "aws_rds_cluster" "this" {
  cluster_identifier     = module.this.id
  engine                 = "aurora-postgresql"
  engine_version         = var.engine_version
  database_name          = var.database_name
  master_username        = var.master_username
  master_password        = var.master_password
  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.cluster.id]

  backup_retention_period      = var.backup_retention_period
  preferred_backup_window      = var.backup_window
  preferred_maintenance_window = var.maintenance_window

  enabled_cloudwatch_logs_exports = ["postgresql"]
  storage_encrypted               = true

  deletion_protection       = var.deletion_protection
  skip_final_snapshot       = !var.deletion_protection
  final_snapshot_identifier = var.deletion_protection ? "${module.this.id}-final-${formatdate("YYYYMMDDhhmm", timestamp())}" : null

  tags = merge(module.this.tags, { Name = module.this.id })

  lifecycle {
    ignore_changes = [final_snapshot_identifier]
  }
}

resource "aws_rds_cluster_instance" "writer" {
  identifier         = "${module.this.id}-writer"
  cluster_identifier = aws_rds_cluster.this.id
  instance_class     = var.instance_class
  engine             = aws_rds_cluster.this.engine
  engine_version     = aws_rds_cluster.this.engine_version

  performance_insights_enabled = var.enable_performance_insights

  tags = merge(module.this.tags, { Name = "${module.this.id}-writer", Role = "writer" })
}

resource "aws_rds_cluster_instance" "reader" {
  count = var.multi_az ? 1 : 0

  identifier         = "${module.this.id}-reader"
  cluster_identifier = aws_rds_cluster.this.id
  instance_class     = var.instance_class
  engine             = aws_rds_cluster.this.engine
  engine_version     = aws_rds_cluster.this.engine_version

  performance_insights_enabled = var.enable_performance_insights

  tags = merge(module.this.tags, { Name = "${module.this.id}-reader", Role = "reader" })
}
