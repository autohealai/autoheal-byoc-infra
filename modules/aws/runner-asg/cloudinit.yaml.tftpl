#cloud-config
%{ if length(trusted_ca_certificates) > 0 ~}
# Private CAs, added to the system trust store (update-ca-trust). cloud-init
# does this before the packages install and before runcmd starts Docker, so
# dnf, the Docker daemon's image pulls and the ECR login trust them.
ca_certs:
  trusted:
%{ for c in trusted_ca_certificates ~}
    - |
      ${indent(6, replace(trimspace(c), "\r", ""))}
%{ endfor ~}
%{ endif ~}
package_update: true
packages:
  - docker
%{ if ecr_registry_host != "" ~}
  - amazon-ecr-credential-helper
%{ endif ~}
%{ if callback_key_secret_arn != "" ~}
  - awscli-2
%{ endif ~}
write_files:
%{ if http_proxy != "" ~}
  # The proxy for dnf, the Docker daemon, the scripts below and runner-go.
  # Written before the packages install, so dnf uses it too.
  - path: /opt/runner-go/proxy.env
    permissions: '0644'
    content: |
      HTTP_PROXY=${http_proxy}
      HTTPS_PROXY=${http_proxy}
      NO_PROXY=${no_proxy}
      http_proxy=${http_proxy}
      https_proxy=${http_proxy}
      no_proxy=${no_proxy}
  - path: /etc/dnf/dnf.conf
    append: true
    content: |
      proxy=${http_proxy}
  - path: /etc/systemd/system/docker.service.d/proxy.conf
    permissions: '0644'
    content: |
      [Service]
      EnvironmentFile=/opt/runner-go/proxy.env
  # The SSM agent, which the AMI starts at boot, reaches SSM through the proxy
  # too. runcmd restarts it to pick this up.
  - path: /etc/systemd/system/amazon-ssm-agent.service.d/proxy.conf
    permissions: '0644'
    content: |
      [Service]
      EnvironmentFile=/opt/runner-go/proxy.env
%{ endif ~}
  # The Docker settings of Autoheal's hosted runners: capped json-file logs,
  # overlay2 and live-restore. The Amazon Linux docker package ships no
  # daemon.json and does not start the daemon, so the file is in place when
  # runcmd starts it. containerd-snapshotter false keeps the overlay2 image
  # store if a later Docker version turns the containerd store on by default.
  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        },
        "storage-driver": "overlay2",
        "features": {
          "containerd-snapshotter": false
        },
        "userland-proxy": false,
        "live-restore": true
      }
  # Root only. TEMPORAL_TLS=false and no TEMPORAL_TOKEN: the runner reaches
  # Temporal on the internal runner load balancer, as Autoheal's hosted runners
  # do, and the network decides who may connect. DISABLED_DRIVERS turns off
  # runner-go's lambda drivers. A lambda would run inside the runner container,
  # on its network, and nothing in the chart starts lambdas. Sandboxes are
  # containers of their own and get none of this environment.
  - path: /opt/runner-go/config.env
    permissions: '0600'
    content: |
      TEMPORAL_HOST=${temporal_host}
      TEMPORAL_NAMESPACE=runners
      TEMPORAL_TLS=false
      TEMPORAL_TOKEN=
      NAME=${runner_name}
      API_WORKER_MAX_CONCURRENT_ACTIVITIES=${max_concurrent_activities}
      WORKER_SHUTDOWN_GRACE_SECONDS=30
      DEBUG_MODE=false
      DOCKER_SOCKET_PATH=/var/run/docker.sock
%{ if ecr_registry_host != "" ~}
      LOCAL_DOCKER_CONFIG_PATH=/opt/runner-go/docker/config.json
%{ endif ~}
      LAMBDA_DOWNLOAD_PATH=/var/lib/runner-go/lambdas
      DISABLED_DRIVERS=shell,bubblewrap
      DATA_SOURCES_PATH=/var/lib/runner-go/datasources
      SANDBOX_BASE_DIR=/var/lib/runner-go/sandboxes
      AGENT_SESSION_SHARED_BASE_DIR=/var/lib/runner-go/agent-sessions
      LOG_LEVEL=info
      LOG_FORMAT=json
      SANDBOX_WORKER_DEPLOYMENT_NAME=sandbox
%{ if tool_response_callback_url != "" ~}
      SANDBOX_TOOL_RESPONSE_CALLBACK_URL=${tool_response_callback_url}
%{ endif ~}
%{ if custom_ca_certificate != "" ~}
  # The customer's private root CAs. runner-go reads this path by default and
  # mounts them, on top of its public roots, into every sandbox it creates.
  - path: /opt/runner-go/ca/custom-ca.pem
    permissions: '0644'
    content: |
      ${indent(6, trimspace(custom_ca_certificate))}
%{ endif ~}
%{ if ecr_registry_host != "" ~}
  # The host docker CLI (runner-pull.sh, the sandbox pre-pull) gets ECR
  # credentials from the instance role through the credential helper.
  - path: /root/.docker/config.json
    permissions: '0600'
    content: |
      {
        "credHelpers": {
          "${ecr_registry_host}": "ecr-login"
        }
      }
  - path: /usr/local/bin/ecr-login.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Write an ECR login file for runner-go. The token is valid for 12
      # hours, so a timer runs this every hour.
      #
      # runner-go pulls the sandbox image through the Docker API, which does
      # not run credential helpers. It reads the file at
      # LOCAL_DOCKER_CONFIG_PATH on every pull and sends the user name and
      # password from its "auth" field, so the file holds the ECR token the
      # credential helper gets with the instance role. The runner runs as uid
      # 1000, so the file is owned by it. It is written to a temporary name and
      # renamed, so a pull never reads a partial file.
      set -euo pipefail
      export HOME=/root DOCKER_CONFIG=/root/.docker
%{ if http_proxy != "" ~}
      set -a; . /opt/runner-go/proxy.env; set +a
%{ endif ~}
      host="${ecr_registry_host}"
      creds=$(printf '%s' "$host" | docker-credential-ecr-login get)
      auth=$(printf '%s' "$creds" | python3 -c 'import base64, json, sys; c = json.load(sys.stdin); print(base64.b64encode((c["Username"] + ":" + c["Secret"]).encode()).decode())')
      test -n "$auth"
      install -d -m 0755 /opt/runner-go/docker
      (umask 077; printf '{"auths":{"%s":{"auth":"%s"}}}\n' "$host" "$auth" > /opt/runner-go/docker/config.json.new)
      chown 1000:1000 /opt/runner-go/docker/config.json.new
      mv -f /opt/runner-go/docker/config.json.new /opt/runner-go/docker/config.json
  - path: /etc/systemd/system/ecr-login.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh the ECR login file for runner-go
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/ecr-login.sh
  - path: /etc/systemd/system/ecr-login.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Hourly ECR login refresh for runner-go
      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=1h
      [Install]
      WantedBy=timers.target
%{ endif ~}
%{ if callback_key_secret_arn != "" ~}
  - path: /usr/local/bin/callback-key.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Write the callback key runner-go sends with each tool result to a
      # root-only file, read from Secrets Manager with the instance role, so
      # the key is never in the user data. It runs before each runner start,
      # so a changed key reaches the runner on its next restart. A failed read
      # fails the start, and systemd retries. The file is written to a
      # temporary name and renamed, so a start never reads a partial file.
      set -euo pipefail
%{ if http_proxy != "" ~}
      set -a; . /opt/runner-go/proxy.env; set +a
%{ endif ~}
%{ if length(trusted_ca_certificates) > 0 ~}
      # The AWS CLI keeps its own CA bundle; a proxy's private CA is in the
      # system one.
      export AWS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
%{ endif ~}
      key=$(aws secretsmanager get-secret-value --region ${callback_key_region} --secret-id '${callback_key_secret_arn}' --query SecretString --output text)
      test -n "$key"
      (umask 077; printf 'SANDBOX_TOOL_RESPONSE_CALLBACK_TOKEN=%s\n' "$key" > /opt/runner-go/callback.env.new)
      mv -f /opt/runner-go/callback.env.new /opt/runner-go/callback.env
%{ endif ~}
  - path: /usr/local/bin/container-firewall.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # The container firewall, in Docker's DOCKER-USER chain, which sees only
      # container traffic, so the host (the ECR login, Docker pulls) is not
      # affected. A reboot clears the rules, so this runs before each runner
      # start, and every 5 minutes to follow address changes.
      #
      # runner-go runs on a network of its own (bridge runner0), and the
      # sandboxes it starts on Docker's default bridge (docker0), so a rule on
      # docker0 holds for sandboxes alone.
      set -euo pipefail
      # The timer and a runner start may both create it; the loser finds it.
      docker network inspect runner-go >/dev/null 2>&1 ||
        docker network create -o com.docker.network.bridge.name=runner0 runner-go >/dev/null ||
        docker network inspect runner-go >/dev/null
      # No container reaches the instance metadata service, on top of the hop
      # limit of 1: a sandbox that reached it could act as the instance role.
      # The reset also makes runner-go's own instance ID lookup fail at once
      # instead of timing out.
      iptables -w -C DOCKER-USER -d 169.254.169.254/32 -p tcp -j REJECT --reject-with tcp-reset 2>/dev/null ||
        iptables -w -I DOCKER-USER -d 169.254.169.254/32 -p tcp -j REJECT --reject-with tcp-reset
      # Sandboxes run untrusted code, and the runner load balancer takes no
      # key, so they do not reach it, nor the other blocked destinations.
      # Names are looked up each run: a load balancer's addresses can change.
      # A name that does not resolve fails the run, so the runner does not
      # start without its rules. The chain is rebuilt in one iptables-restore
      # transaction, which leaves no moment without rules.
      rules=""
      for d in ${join(" ", sandbox_blocked_destinations)}; do
        case "$d" in
          */*) addrs="$d" ;;
          *) addrs=$(getent ahostsv4 "$d" | awk '{ print $1 "/32" }' | sort -u || true) ;;
        esac
        if [ -z "$addrs" ]; then echo "cannot resolve $d"; exit 1; fi
        for a in $addrs; do
          rules="$rules-A AUTOHEAL-SANDBOX -d $a -p tcp -j REJECT --reject-with tcp-reset"$'\n'
        done
      done
      printf '*filter\n:AUTOHEAL-SANDBOX - [0:0]\n%sCOMMIT\n' "$rules" | iptables-restore -w --noflush
      iptables -w -C DOCKER-USER -i docker0 -j AUTOHEAL-SANDBOX 2>/dev/null ||
        iptables -w -I DOCKER-USER -i docker0 -j AUTOHEAL-SANDBOX
  - path: /etc/systemd/system/container-firewall.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh the container firewall for runner-go sandboxes
      After=docker.service
      Requires=docker.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/container-firewall.sh
  - path: /etc/systemd/system/container-firewall.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Container firewall refresh every 5 minutes
      [Timer]
      OnBootSec=5min
      OnUnitActiveSec=5min
      [Install]
      WantedBy=timers.target
  - path: /usr/local/bin/runner-pull.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Pull the runner image, retrying until it succeeds. The instances may
      # boot before the image can be pulled (a new mirror, an IAM grant that is
      # still propagating), so a failed pull waits and tries again: 15s,
      # doubling up to 5 minutes. With an ECR registry, runner-go's login file
      # is refreshed before each try as well.
      export HOME=/root DOCKER_CONFIG=/root/.docker
%{ if http_proxy != "" ~}
      # The docker CLI runs the ECR credential helper, which calls ECR itself.
      set -a; . /opt/runner-go/proxy.env; set +a
%{ endif ~}
      image="$1"
      ecr_registry_host="${ecr_registry_host}"
      delay=15
      while true; do
        if [ -n "$ecr_registry_host" ]; then /usr/local/bin/ecr-login.sh || true; fi
        /usr/bin/docker pull "$image" && exit 0
        echo "pull of $image failed, retrying in $delay seconds"
        sleep "$delay"
        delay=$(( delay * 2 ))
        if [ "$delay" -gt 300 ]; then delay=300; fi
      done
  - path: /etc/systemd/system/runner-go.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Autoheal runner-go (Docker-out-of-Docker sandbox worker)
      After=docker.service network-online.target%{ if ecr_registry_host != "" } ecr-login.service%{ endif }
      Wants=network-online.target
      Requires=docker.service
      # No start limit: a failed start is retried for as long as it takes.
      StartLimitIntervalSec=0
      [Service]
      Restart=always
      RestartSec=10
      # The pull waits until it succeeds, so no start timeout.
      TimeoutStartSec=infinity
      ExecStartPre=-/usr/bin/docker rm -f runner-go
      # No "-": without the rules the runner does not start, and systemd retries.
      ExecStartPre=/usr/local/bin/container-firewall.sh
      ExecStartPre=/usr/local/bin/runner-pull.sh ${runner_image}
%{ if callback_key_secret_arn != "" ~}
      # No "-": without the callback key the runner does not start.
      ExecStartPre=/usr/local/bin/callback-key.sh
%{ endif ~}
      # --group-add <docker-gid>: the runner container runs as uid/gid 1000
      # (alpine adduser 'runner'); the host docker.sock is root:docker mode 660,
      # so the runner must join the host docker group to drive the daemon (DooD).
      # __DOCKER_GID__ is substituted from the host's actual docker gid in runcmd.
      # Each identity dir is bind-mounted at an IDENTICAL host<->container path:
      # startup.ValidateIdentityMounts requires an exact mount entry whose
      # Destination == SANDBOX_BASE_DIR / DATA_SOURCES_PATH (a single parent
      # mount of /var/lib/runner-go does NOT satisfy the subpath check), and
      # sandbox bind-mounts resolve on the HOST so the paths must match.
%{ if ecr_registry_host != "" ~}
      # /opt/runner-go/docker holds the ECR login ecr-login.sh writes for the
      # runner, mounted read-only. It is a directory mount because the login
      # file is replaced on each refresh, and a file mount would keep the old one.
%{ endif ~}
      # --hostname %H: the instance's host name, which is its instance ID (the
      # launch template sets resource-name host names). runner-go names its
      # per-host task queue after the instance ID it reads from IMDS, or the
      # host name when IMDS is out of reach, as here. The container's default
      # host name is its id, which changes on every restart and leaves the
      # sandboxes placed before it with no worker.
      # HOSTNAME=runner-go: at start runner-go looks up its own container by
      # $HOSTNAME to check the mounts below. Docker sets $HOSTNAME to the
      # --hostname value, which is not a container name, so it is set to the
      # container name here. The host queue uses the kernel host name, not this.
      # --network runner-go: the runner's own network, outside the sandbox
      # rules on docker0 (container-firewall.sh).
      ExecStart=/usr/bin/docker run --rm --name runner-go --hostname %H -e HOSTNAME=runner-go --network runner-go --group-add __DOCKER_GID__ \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v /var/lib/runner-go/lambdas:/var/lib/runner-go/lambdas \
        -v /var/lib/runner-go/datasources:/var/lib/runner-go/datasources \
        -v /var/lib/runner-go/sandboxes:/var/lib/runner-go/sandboxes \
        -v /var/lib/runner-go/agent-sessions:/var/lib/runner-go/agent-sessions \
%{ if ecr_registry_host != "" ~}
        -v /opt/runner-go/docker:/opt/runner-go/docker:ro \
%{ endif ~}
%{ if custom_ca_certificate != "" ~}
        -v /opt/runner-go/ca:/opt/runner-go/ca:ro \
%{ endif ~}
        --env-file /opt/runner-go/config.env \
%{ if callback_key_secret_arn != "" ~}
        --env-file /opt/runner-go/callback.env \
%{ endif ~}
%{ if http_proxy != "" ~}
        --env-file /opt/runner-go/proxy.env \
%{ endif ~}
        ${runner_image}
      # runner-go drains for WORKER_SHUTDOWN_GRACE_SECONDS (30), so docker
      # stop waits 45s before it kills, within systemd's 90s stop timeout.
      ExecStop=/usr/bin/docker stop -t 45 runner-go
      [Install]
      WantedBy=multi-user.target
runcmd:
  # runner-go container runs as uid/gid 1000 (alpine adduser); the bind-mounted
  # state dir must be writable by it, and sandbox bind-mounts resolve on the HOST
  # at the same path (DooD), so keep paths identical container<->host. A missing
  # dir is created by docker as root when the runner starts, and the runner
  # cannot write to it.
  - mkdir -p /var/lib/runner-go/lambdas /var/lib/runner-go/datasources /var/lib/runner-go/sandboxes /var/lib/runner-go/agent-sessions
  - chown -R 1000:1000 /var/lib/runner-go
  # Picks up the Docker drop-in and the units written above.
  - systemctl daemon-reload
%{ if http_proxy != "" ~}
  # The SSM agent started without the proxy. try-restart leaves it stopped
  # where it does not run.
  - systemctl try-restart amazon-ssm-agent
%{ endif ~}
  - systemctl enable --now docker
  - systemctl enable --now container-firewall.timer
%{ if ecr_registry_host != "" ~}
  - systemctl enable --now ecr-login.timer
  # May fail while the instance role's permissions propagate; runner-pull.sh
  # tries again.
  - /usr/local/bin/ecr-login.sh || true
%{ endif ~}
  # Substitute the host's real docker gid into the runner unit (only known now
  # that the docker package is installed), so the container can access the host
  # socket. Single-quoted for YAML: a bare "-d: " would turn the item into a
  # mapping, which cloud-init does not run.
  - 'sed -i "s/__DOCKER_GID__/$(getent group docker | cut -d: -f3)/" /etc/systemd/system/runner-go.service'
%{ if sandbox_image != "" ~}
  # Pre-pull the sandbox image so the first investigation doesn't wait on a cold pull
  - DOCKER_CONFIG=/root/.docker docker pull ${sandbox_image} || true
%{ endif ~}
  - systemctl daemon-reload
  # --no-block: the start waits in runner-pull.sh until the pull succeeds,
  # which must not hold up cloud-init.
  - systemctl enable runner-go.service
  - systemctl start --no-block runner-go.service
