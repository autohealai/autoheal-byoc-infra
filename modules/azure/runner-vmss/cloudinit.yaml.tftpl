#cloud-config
package_update: true
packages:
  - docker.io
  - curl
write_files:
  - path: /opt/runner-go/config.env
    permissions: '0644'
    content: |
      TEMPORAL_HOST=${temporal_host}
      TEMPORAL_NAMESPACE=runners
      TEMPORAL_TLS=false
      TEMPORAL_TOKEN=
      NAME=${runner_name}
      API_WORKER_MAX_CONCURRENT_ACTIVITIES=${max_concurrent_activities}
      WORKER_SHUTDOWN_GRACE_SECONDS=30
      DEBUG_MODE=false
      DOCKER_SOCKET_PATH=/var/run/docker.sock
%{ if acr_name != "" ~}
      LOCAL_DOCKER_CONFIG_PATH=/opt/runner-go/docker/config.json
%{ endif ~}
      LAMBDA_DOWNLOAD_PATH=/var/lib/runner-go/lambdas
      DATA_SOURCES_PATH=/var/lib/runner-go/datasources
      SANDBOX_BASE_DIR=/var/lib/runner-go/sandboxes
      AGENT_SESSION_SHARED_BASE_DIR=/var/lib/runner-go/agent-sessions
      LOG_LEVEL=info
      LOG_FORMAT=json
      SANDBOX_WORKER_DEPLOYMENT_NAME=sandbox
%{ if tool_response_callback_url != "" ~}
      SANDBOX_TOOL_RESPONSE_CALLBACK_URL=${tool_response_callback_url}
%{ endif ~}
%{ if acr_name != "" ~}
  - path: /usr/local/bin/acr-login.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Log the host docker CLI in to ACR with the VM's managed identity, and
      # give runner-go a copy of the login. The token expires after about 3
      # hours, so a timer runs this every hour.
      #
      # runner-go pulls the sandbox image through the Docker API, which does not
      # use the host's docker login. It sends the credentials it reads from
      # LOCAL_DOCKER_CONFIG_PATH, and reads that file on every pull. The runner
      # runs as uid 1000, so the copy is owned by it. The copy is written to a
      # temporary name and renamed, so a pull never reads a partial file.
      set -e
      export DOCKER_CONFIG=/root/.docker
      az login --identity --client-id ${uami_client_id} >/dev/null 2>&1
      az acr login -n ${acr_name} >/dev/null 2>&1
      install -D -m 0600 -o 1000 -g 1000 /root/.docker/config.json /opt/runner-go/docker/config.json.new
      mv -f /opt/runner-go/docker/config.json.new /opt/runner-go/docker/config.json
  - path: /etc/systemd/system/acr-login.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh ACR docker credentials
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/acr-login.sh
  - path: /etc/systemd/system/acr-login.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Hourly ACR docker credential refresh
      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=1h
      [Install]
      WantedBy=timers.target
%{ endif ~}
  - path: /usr/local/bin/runner-pull.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Pull the runner image, retrying until it succeeds. The VMs boot during
      # the first apply, often before the image is pushed to a new registry, so
      # a failed pull waits and tries again: 15s, doubling up to 5 minutes. With
      # a registry login, the credentials are refreshed before each try, which
      # also covers a role grant that is still propagating.
      image="$1"
      acr_name="${acr_name}"
      delay=15
      while true; do
        if [ -n "$acr_name" ]; then /usr/local/bin/acr-login.sh || true; fi
        /usr/bin/docker pull "$image" && exit 0
        echo "pull of $image failed, retrying in $delay seconds"
        sleep "$delay"
        delay=$(( delay * 2 ))
        if [ "$delay" -gt 300 ]; then delay=300; fi
      done
  - path: /etc/systemd/system/runner-go.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Autoheal runner-go (Docker-out-of-Docker sandbox worker)
      After=docker.service network-online.target%{ if acr_name != "" } acr-login.service%{ endif }
      Wants=network-online.target
      Requires=docker.service
      # No start limit: a failed start is retried for as long as it takes.
      StartLimitIntervalSec=0
      [Service]
      Restart=always
      RestartSec=10
      # The pull step waits until the image exists, so it has no start timeout.
      TimeoutStartSec=infinity
      ExecStartPre=-/usr/bin/docker rm -f runner-go
      ExecStartPre=/usr/local/bin/runner-pull.sh ${runner_image}
      # --group-add <docker-gid>: the runner container runs as uid/gid 1000
      # (alpine adduser 'runner'); the host docker.sock is root:docker mode 660,
      # so the runner must join the host docker group to drive the daemon (DooD).
      # __DOCKER_GID__ is substituted from the host's actual docker gid in runcmd.
      # Each identity dir is bind-mounted at an IDENTICAL host<->container path:
      # startup.ValidateIdentityMounts requires an exact mount entry whose
      # Destination == SANDBOX_BASE_DIR / DATA_SOURCES_PATH (a single parent
      # mount of /var/lib/runner-go does NOT satisfy the subpath check), and
      # sandbox bind-mounts resolve on the HOST so the paths must match.
%{ if acr_name != "" ~}
      # /opt/runner-go/docker holds the ACR login acr-login.sh writes for the
      # runner, mounted read-only. It is a directory mount because the login
      # file is replaced on each refresh, and a file mount would keep the old one.
%{ endif ~}
      ExecStart=/usr/bin/docker run --rm --name runner-go --group-add __DOCKER_GID__ \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v /var/lib/runner-go/lambdas:/var/lib/runner-go/lambdas \
        -v /var/lib/runner-go/datasources:/var/lib/runner-go/datasources \
        -v /var/lib/runner-go/sandboxes:/var/lib/runner-go/sandboxes \
        -v /var/lib/runner-go/agent-sessions:/var/lib/runner-go/agent-sessions \
%{ if acr_name != "" ~}
        -v /opt/runner-go/docker:/opt/runner-go/docker:ro \
%{ endif ~}
        --env-file /opt/runner-go/config.env \
        ${runner_image}
      ExecStop=/usr/bin/docker stop runner-go
      [Install]
      WantedBy=multi-user.target
runcmd:
%{ if acr_name != "" ~}
  # Install the Azure CLI, which acr-login.sh uses to log in to ACR with the
  # VM's managed identity.
  - curl -sL https://aka.ms/InstallAzureCLIDeb | bash
%{ endif ~}
  # runner-go container runs as uid/gid 1000 (alpine adduser); the bind-mounted
  # state dir must be writable by it, and sandbox bind-mounts resolve on the HOST
  # at the same path (DooD), so keep paths identical container<->host.
  # cloud-init runs these with /bin/sh (dash on Ubuntu), which has no brace
  # expansion, so each dir is listed in full. A missing dir is created by docker
  # as root when the runner starts, and the runner cannot write to it.
  - mkdir -p /var/lib/runner-go/lambdas /var/lib/runner-go/datasources /var/lib/runner-go/sandboxes /var/lib/runner-go/agent-sessions
  - chown -R 1000:1000 /var/lib/runner-go
  - systemctl enable --now docker
%{ if acr_name != "" ~}
  - systemctl enable --now acr-login.timer
  # May fail while the AcrPull grant propagates; runner-pull.sh logs in again.
  - /usr/local/bin/acr-login.sh || true
%{ endif ~}
  # Substitute the host's real docker gid into the runner unit (only known now
  # that docker.io is installed), so the container can access the host socket.
  # Single-quoted for YAML: a bare "-d: " would turn the item into a mapping,
  # which cloud-init does not run.
  - 'sed -i "s/__DOCKER_GID__/$(getent group docker | cut -d: -f3)/" /etc/systemd/system/runner-go.service'
%{ if sandbox_image != "" ~}
  # Pre-pull the sandbox image so the first investigation doesn't wait on a cold pull
  - docker pull ${sandbox_image} || true
%{ endif ~}
  - systemctl daemon-reload
  # --no-block: the start waits in runner-pull.sh until the image exists, which
  # must not hold up cloud-init.
  - systemctl enable runner-go.service
  - systemctl start --no-block runner-go.service
